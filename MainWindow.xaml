<Window x:Class="WeatherWidget.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:WeatherWidget"
        WindowStyle="None"
        Background="Transparent"
        Width="280" Height="380"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Topmost="False"
        FontFamily="Segoe UI, Microsoft YaHei"
        Loaded="Window_Loaded"
        Closing="Window_Closing"
        MouseLeftButtonDown="Window_MouseLeftButtonDown">

    <Window.Resources>

        <Style x:Key="CircleBtn" TargetType="Button">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Ellipse Fill="{TemplateBinding Background}"/>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                              RecognizesAccessKey="False"/>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CloseBtnStyle" TargetType="Button" BasedOn="{StaticResource CircleBtn}">
            <Setter Property="Background" Value="#12FFFFFF"/>
            <Setter Property="Foreground" Value="#80FFFFFF"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#59FF5050"/>
                    <Setter Property="Foreground" Value="White"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="AutoBtnStyle" TargetType="Button" BasedOn="{StaticResource CircleBtn}">
            <Setter Property="Background" Value="#1FFFFFFF"/>
            <Setter Property="Foreground" Value="#D9FFFFFF"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#40FFFFFF"/>
                </Trigger>
                <Trigger Property="Tag" Value="on">
                    <Setter Property="Background" Value="#FF2196F3"/>
                    <Setter Property="Foreground" Value="White"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="LocBtnStyle" TargetType="Button" BasedOn="{StaticResource CircleBtn}">
            <Setter Property="Background" Value="#12FFFFFF"/>
            <Setter Property="Foreground" Value="#80FFFFFF"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#40FFFFFF"/>
                    <Setter Property="Foreground" Value="White"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="CityBtnStyle" TargetType="Button">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Background" Value="#12FFFFFF"/>
            <Setter Property="Foreground" Value="#D9FFFFFF"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" CornerRadius="6" Background="{TemplateBinding Background}" Padding="8,2">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#2EFFFFFF"/>
                </Trigger>
            </Style.Triggers>
        </Style>

    </Window.Resources>

    <Border x:Name="RootBorder" CornerRadius="16" ClipToBounds="True">
        <Border.Background>
            <SolidColorBrush x:Name="TintBrush" Color="#00FFFFFF"/>
        </Border.Background>
        <Grid>

            <local:ParticleLayer x:Name="StarsCanvas" ClipToBounds="True"/>
            <local:ParticleLayer x:Name="SnowCanvas" Opacity="0.5" ClipToBounds="True"/>
            <local:ParticleLayer x:Name="RainCanvas" Opacity="0.5" ClipToBounds="True"/>

            <Grid Margin="12,26,12,8">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" HorizontalAlignment="Center">
                    <TextBlock x:Name="TimeText" Text="00:00:00" FontSize="36" FontWeight="Light"
                               Foreground="White" HorizontalAlignment="Center"/>
                    <TextBlock x:Name="DateText" Text="" FontSize="11" FontWeight="Light"
                               Foreground="#B3FFFFFF" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                </StackPanel>

                <Border Grid.Row="1" Height="1" Background="#1AFFFFFF" Margin="0,6"/>

                <Grid Grid.Row="2">
                    <StackPanel VerticalAlignment="Center">

                        <Canvas x:Name="WeatherIconCanvas" Width="44" Height="44"
                                HorizontalAlignment="Center" Margin="0,0,0,2" RenderTransformOrigin="0.5,0.5">
                            <Canvas.RenderTransform>
                                <TransformGroup>
                                    <ScaleTransform x:Name="IconScale"/>
                                    <RotateTransform x:Name="IconRotate"/>
                                    <TranslateTransform x:Name="IconTranslate"/>
                                </TransformGroup>
                            </Canvas.RenderTransform>
                        </Canvas>

                        <TextBlock HorizontalAlignment="Center" Margin="0,0,0,2">
                            <Run x:Name="TempRun" Text="--" FontSize="32" FontWeight="Light" Foreground="White"/>
                            <Run x:Name="TempUnit" Text="°C" FontSize="16" FontWeight="Light" BaselineAlignment="Top" Foreground="White"/>
                        </TextBlock>

                        <TextBlock x:Name="WeatherDescText" Text="正在获取天气数据..." FontSize="13" FontWeight="Light"
                                   Foreground="#D9FFFFFF" HorizontalAlignment="Center" Margin="0,0,0,4"/>

                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <TextBlock FontSize="11" Foreground="#A6FFFFFF"><Run Text="体感 "/><Bold><Run x:Name="FeelsRun" Text="--°C"/></Bold></TextBlock>
                            <TextBlock FontSize="11" Foreground="#A6FFFFFF" Margin="10,0,0,0"><Run Text="湿 "/><Bold><Run x:Name="HumidRun" Text="--%"/></Bold></TextBlock>
                            <TextBlock FontSize="11" Foreground="#A6FFFFFF" Margin="10,0,0,0"><Run Text="风 "/><Bold><Run x:Name="WindRun" Text="--km/h"/></Bold></TextBlock>
                        </StackPanel>

                        <TextBlock x:Name="ErrorText" Text="" FontSize="11" Foreground="#FF6B6B"
                                   HorizontalAlignment="Center" Height="14" Margin="0,2,0,0"/>

                        <StackPanel Margin="0,5,0,0">
                            <TextBlock Text="未来三天" FontSize="10" Foreground="#73FFFFFF"
                                       HorizontalAlignment="Center" Margin="0,0,0,3"/>
                            <UniformGrid Columns="3">
                                <StackPanel>
                                    <TextBlock x:Name="FDate0" Text="今天" FontSize="10" Foreground="#99FFFFFF" HorizontalAlignment="Center" Margin="0,0,0,1"/>
                                    <Canvas x:Name="FIcon0" Width="20" Height="20" HorizontalAlignment="Center" Margin="0,3,0,0"/>
                                    <TextBlock x:Name="FTemp0" Text="--°" FontSize="11" FontWeight="Light" Foreground="White" HorizontalAlignment="Center"/>
                                </StackPanel>
                                <StackPanel>
                                    <TextBlock x:Name="FDate1" Text="明天" FontSize="10" Foreground="#99FFFFFF" HorizontalAlignment="Center" Margin="0,0,0,1"/>
                                    <Canvas x:Name="FIcon1" Width="20" Height="20" HorizontalAlignment="Center" Margin="0,3,0,0"/>
                                    <TextBlock x:Name="FTemp1" Text="--°" FontSize="11" FontWeight="Light" Foreground="White" HorizontalAlignment="Center"/>
                                </StackPanel>
                                <StackPanel>
                                    <TextBlock x:Name="FDate2" Text="后天" FontSize="10" Foreground="#99FFFFFF" HorizontalAlignment="Center" Margin="0,0,0,1"/>
                                    <Canvas x:Name="FIcon2" Width="20" Height="20" HorizontalAlignment="Center" Margin="0,3,0,0"/>
                                    <TextBlock x:Name="FTemp2" Text="--°" FontSize="11" FontWeight="Light" Foreground="White" HorizontalAlignment="Center"/>
                                </StackPanel>
                            </UniformGrid>
                        </StackPanel>

                    </StackPanel>
                </Grid>
            </Grid>

            <Button x:Name="CloseBtn" Content="✕" Width="20" Height="20" FontSize="10"
                    Style="{StaticResource CloseBtnStyle}"
                    HorizontalAlignment="Left" VerticalAlignment="Top" Margin="10,10,0,0"
                    Click="CloseBtn_Click"/>
            <Button x:Name="AutoBtn" Content="⚡" Width="20" Height="20" FontSize="12" FontWeight="Bold"
                    Style="{StaticResource AutoBtnStyle}"
                    HorizontalAlignment="Left" VerticalAlignment="Top" Margin="36,10,0,0"
                    ToolTip="开机自启" Click="AutoBtn_Click"/>
            <Button x:Name="LocBtn" Content="📍" Width="20" Height="20" FontSize="11"
                    Style="{StaticResource LocBtnStyle}"
                    HorizontalAlignment="Left" VerticalAlignment="Top" Margin="62,10,0,0"
                    ToolTip="定位" RenderTransformOrigin="0.5,0.5" Click="LocBtn_Click">
                <Button.RenderTransform>
                    <RotateTransform x:Name="LocSpin"/>
                </Button.RenderTransform>
            </Button>

            <Button x:Name="CityBtn" Content="加载中 ▾" Style="{StaticResource CityBtnStyle}"
                    HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,8,10,0"
                    Click="CityBtn_Click"/>

            <Border x:Name="CityDropdown" Visibility="Collapsed"
                    HorizontalAlignment="Right" VerticalAlignment="Top"
                    Margin="0,30,10,0" MinWidth="130" MaxHeight="280"
                    CornerRadius="10" Background="#BF1E2837" Padding="0,4"
                    MouseLeftButtonDown="Dropdown_MouseLeftButtonDown">
                <Border.Resources>
                    <Style TargetType="ScrollBar">
                        <Setter Property="Width" Value="3"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ScrollBar">
                                    <Grid Background="Transparent">
                                        <Track x:Name="PART_Track" IsDirectionReversed="True">
                                            <Track.Thumb>
                                                <Thumb>
                                                    <Thumb.Template>
                                                        <ControlTemplate TargetType="Thumb">
                                                            <Border CornerRadius="1.5" Background="#26FFFFFF"/>
                                                        </ControlTemplate>
                                                    </Thumb.Template>
                                                </Thumb>
                                            </Track.Thumb>
                                        </Track>
                                    </Grid>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </Border.Resources>
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,0,2,0">
                    <StackPanel>
                        <StackPanel x:Name="ProvinceLevel"/>
                        <StackPanel x:Name="CityLevel" Visibility="Collapsed">
                            <Border x:Name="MenuBack" Padding="12,5" Background="Transparent" Cursor="Hand"
                                    MouseLeftButtonDown="MenuBack_Click">
                                <TextBlock Text="← 返回" FontSize="11" Foreground="#80FFFFFF"/>
                            </Border>
                            <StackPanel x:Name="CityList"/>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </Border>

        </Grid>
    </Border>
</Window>
